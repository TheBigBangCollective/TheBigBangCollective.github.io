---
import FrontPage  from "../layouts/FrontPage.astro";
import Headline   from "../components/Headline.astro";
import Timeline   from "../components/Timeline.astro";
import { getEntryBySlug } from "astro:content";

/* get the 2024 markdown entry */
const { data } = await getEntryBySlug('years', '2024');
---

<FrontPage title="2024 Programme">
  <div class="text-gray-800 px-5 pb-5 md:p-8 md:pt-2">
    <Headline>{data.title}</Headline>

      <p class="intro-copy">
        {data.intro}
      </p>
    </div>

  <Timeline festivals={data.festivals} />
</FrontPage>
