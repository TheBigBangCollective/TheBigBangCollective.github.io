---
import Headline from '../components/Headline.astro';
import FrontPage from '../layouts/FrontPage.astro';
import CollaboratorsMap from '../components/CollaboratorsMap.astro';
import PersonCard from '../components/PersonCard.astro';
import { Image } from 'astro:assets';
import chris from '../assets/site/chris.png';
import connie from '../assets/site/connie.png';
import roger from '../assets/site/roger.jpg';
import team1 from '../assets/site/team1.jpg';
import team2 from '../assets/site/team2.jpg';
import team3 from '../assets/site/team3.jpg';
import team4 from '../assets/site/team4.jpg';
import team5 from '../assets/site/team5.jpg';

/* Team lists: add, remove or reorder freely */

const founders = [
  { name: 'Chris Thomas', affiliation: 'CERN', image: chris },
  { name: 'Connie Potter', affiliation: 'CERN', image: connie }
];

const coreProduction = [
  { name: 'Connie Potter', affiliation: 'CERN', image: connie },
  { name: 'Phill Fox', affiliation: 'Adaptavist' },
  { name: 'Kaj Siebert', affiliation: 'K-Si' }
];

const videoPhoto = [
  { name: 'Charlotte Potter-Landua' },
  { name: 'Orlando Prügel-Bennett', affiliation: 'orlandopb.com' },
  { name: 'Claudia Sabeh' },
  { name: 'Maria Fernandez Martinez' }
];

const collaborators = {
  UK: [
    { name: 'Roger Jones', affiliation: 'Lancaster University', image: roger },
    { name: 'Alex Cerri', affiliation: 'Siena University' },
    { name: 'Dave Wark', affiliation: 'Oxford University' },
    { name: 'Dan Hardiker' }
  ],
  Denmark: [
    { name: 'Joergen Beck Hansen', affiliation: 'Niels Bohr Institut' },
    { name: 'Ulrik Uggerhøj', affiliation: 'Aarhus University' },
    { name: 'Lars Varming Joergensen', affiliation: 'CERN' }
  ],
  Czechia: [
    { name: 'Martin Rybar', affiliation: 'Charles University' },
    { name: 'Vojtech Pleskot', affiliation: 'Charles University' }
  ],
  Slovakia: [
    { name: 'Samuel Kovacik', affiliation: 'Comenius University' },
    { name: 'Juraj Tekel', affiliation: 'Comenius University' },
    { name: 'Robert Astalos', affiliation: 'Comenius University' },
    { name: 'Tomas Dado', affiliation: 'Comenius University' }
  ],
  Spain: [
    { name: 'Eduardo Saenz de Cabezón', affiliation: 'Universidad de La Rioja' },
    { name: 'Cristina Romera Castillo', affiliation: 'ICM, CSIC' },
    { name: 'Ivan Lopez', affiliation: 'IMB-CNM, CSIC' },
    { name: 'Jesus Puerta Pelayo', affiliation: 'CIEMAT' },
    { name: 'José Calabuig Rodriguez', affiliation: 'UPV' }
  ]
};

/* Affiliation names that render as links */
const affiliationLinks = {
  CERN: 'https://home.cern/',
  Adaptavist: 'https://www.adaptavist.com/',
  'Lancaster University': 'https://www.lancaster.ac.uk/',
  'Siena University': 'https://www.unisi.it/',
  'Oxford University': 'https://www.ox.ac.uk/',
  'Niels Bohr Institut': 'https://www.nbi.ku.dk/',
  'Aarhus University': 'https://international.au.dk/',
  'Charles University': 'https://cuni.cz/',
  'Comenius University': 'https://uniba.sk/',
  'Universidad de La Rioja': 'https://www.unirioja.es/',
  'ICM, CSIC': 'https://www.icm.csic.es/',
  'IMB-CNM, CSIC': 'https://www.imb-cnm.csic.es/',
  CIEMAT: 'https://www.ciemat.es/',
  UPV: 'https://www.upv.es/',
  'orlandopb.com': 'https://orlandopb.com/',
  'K-Si': 'https://www.k-si.com/'
};

/* Soft section colours (same family as the festival bands) and a deeper
   accent for each, used for headings and initials */
const sections = [
  { title: 'Founders', people: founders, band: '#fde8ec', accent: '#8c1d3f' },
  { title: 'Core Production Team', people: coreProduction, band: '#fdf1e1', accent: '#7a3e12' },
  { title: 'Video & Photo Team', people: videoPhoto, band: '#e8f1fd', accent: '#0d47a1' },
];

const teamPhotos = [team1, team2, team3, team4, team5];

/* Collaborator dot positions on the 768×768 map image */
const coords = {
  UK: { x: 250, y: 370 },
  Denmark: { x: 395, y: 320 },
  Czechia: { x: 460, y: 455 },
  Slovakia: { x: 500, y: 475 },
  Spain: { x: 130, y: 600 }
};
---

<FrontPage title="About Us">
  <!-- intro, with the team photos as a row of prints -->
  <section class="about-intro">
    <Headline>The Team</Headline>
    <p class="intro-copy max-w-prose mx-auto px-4">
      The Big Bang Collective is a group of scientists, makers and storytellers
      turning physics into unforgettable festival experiences. Meet the people
      behind the experiments.
    </p>
    <ul class="about-prints">
      {teamPhotos.map((photo, i) => (
        <li class="tilt">
          <Image src={photo} widths={[240, 480]} sizes="240px" alt={`The Big Bang Collective team at a festival (${i + 1})`} />
        </li>
      ))}
    </ul>
  </section>

  {sections.map((s) => (
    <section class="about-band" style={`--band: ${s.band}; --accent: ${s.accent}`}>
      <Headline>{s.title}</Headline>
      <ul class="about-people">
        {s.people.map((p) => (
          <PersonCard name={p.name} affiliation={p.affiliation} link={affiliationLinks[p.affiliation]} image={p.image} />
        ))}
      </ul>
    </section>
  ))}

  <CollaboratorsMap
    collaborators={collaborators}
    coords={coords}
    affiliationLinks={affiliationLinks}
  />
</FrontPage>

<style>
  .about-intro {
    padding: 3rem 0 3.5rem;
  }
  .about-prints {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    max-width: 72rem;
    margin: 2.5rem auto 0;
    padding: 0 1rem;
  }
  .about-prints li {
    width: clamp(9rem, 18vw, 13rem);
    border: 5px solid #fff;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.4);
  }
  .about-prints li:nth-child(odd) { --tilt: -2.5deg; }
  .about-prints li:nth-child(even) { --tilt: 2deg; }
  .about-prints :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .about-band {
    padding: 2.5rem 1rem 3.5rem;
    background: var(--band);
  }
  .about-band :global(h2) { color: var(--accent); }
  .about-people {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    max-width: 60rem;
    margin: 0 auto;
  }
</style>
