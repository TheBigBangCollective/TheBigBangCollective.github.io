---
import FrontPage    from "../layouts/FrontPage.astro";
import Headline     from "../components/Headline.astro";
import Timeline     from "../components/Timeline.astro";
import BannerImages from "../components/BannerImages.astro";
import { getEntryBySlug } from "astro:content";

import quantumCorral    from "../assets/images/2026/luck/Quantum_Corral.jpeg";
import solderingWorkshop from "../assets/images/2026/luck/Soldering_Workshop.jpeg";

/* get the 2026 markdown entry */
const { data } = await getEntryBySlug('years', '2026');
---

<FrontPage>
  <BannerImages
    slot="banner"
    images={[
      { src: quantumCorral,    alt: "The Quantum Corral tent at LUCK Reunion" },
      { src: solderingWorkshop, alt: "A soldering workshop inside the Quantum Corral" }
    ]}
  />

  <div class="text-gray-800 p-8 pt-2">
    <Headline>{data.title}</Headline>

      <p class="intro-copy">
        {data.intro}
      </p>
    </div>

  <Timeline festivals={data.festivals} />
</FrontPage>
