---
/**
 * Photo grid for the history page. Captions and alt text come from
 * src/assets/gallery/gallery.json; clicking a photo opens the shared lightbox.
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro:assets";
import Lightbox from "./Lightbox.astro";
import files from "../assets/gallery/gallery.json";

const galleryImages = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpeg,jpg,png,webp}', { eager: true });

const images = await Promise.all(
  files
    .map((file) => ({ file, src: galleryImages[`../assets/gallery/${file.filename}`]?.default }))
    .filter((item) => item.src)
    .map(async ({ file, src }) => ({
      file,
      src,
      full: await getImage({ src, format: 'webp', width: 1600, quality: 80 }),
    }))
);
---
<div class="gallery-grid" data-lightbox-group>
  {images.map(({ file, src, full }) => (
    <Image
      src={src}
      alt={file.alt_text}
      widths={[300, 600]}
      sizes="(min-width: 1200px) 240px, (min-width: 640px) 25vw, 50vw"
      class="gallery-thumb"
      data-title={file.title}
      data-full-src={full.src}
    />
  ))}
</div>
<Lightbox />

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.5rem;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .gallery-grid :global(.gallery-thumb) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .gallery-grid :global(.gallery-thumb:hover),
  .gallery-grid :global(.gallery-thumb:focus-visible) {
    transform: scale(1.03);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }
</style>
