---
/**
 * Looping showreel banner. A responsive still shows instantly; the video only starts
 * downloading once the rest of the page has loaded, and is skipped entirely
 * for visitors who prefer reduced motion or have Data Saver on.
 */
import { Image } from "astro:assets";

const { class: classes, src } = Astro.props;
---

<section class={classes}>
  <div class="video-container">
    {src && (
      <Image
        src={src}
        alt=""
        widths={[480, 800, 1280, 1600]}
        sizes="100vw"
        quality={70}
        loading="eager"
        fetchpriority="high"
        class="video"
      />
    )}
    <video
      id="banner-video"
      class="video"
      muted
      playsinline
      disablepictureinpicture
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
  <div class="text-container">
    <slot />
  </div>
</section>
<style>
  section {
    display: flex;
    overflow: hidden;
    align-items: center;
    justify-items: center;
  }
  .text-container {
    position: absolute;
    top: 0;
    left: 0;
  }
  .video-container {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background-color: #474284;
  }
  .video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  const videoUrls = [
    "https://kws-public-stuff.s3.amazonaws.com/bigbang-womad-2019-q0.mp4",
    "https://kws-public-stuff.s3.amazonaws.com/bigbang-roskilde-2022-q0.mp4"
  ];
  const randomVideoUrl = () => videoUrls[Math.floor(Math.random() * videoUrls.length)];

  const video = document.getElementById("banner-video") as HTMLVideoElement | null;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as any).connection?.saveData;

  function start() {
    if (!video) return;
    video.src = randomVideoUrl();
    video.play().catch(() => {});
    video.addEventListener("ended", () => {
      video.src = randomVideoUrl();
      video.play().catch(() => {});
    });
  }

  if (video && !reducedMotion && !saveData) {
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
