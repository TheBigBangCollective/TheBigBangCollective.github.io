---
import { slug as githubSlug } from 'github-slugger';

const content = await Astro.slots.render('default')
const slug = githubSlug(content)
---
<h2 id={slug} class="transition-all font-heading text-3xl md:text-6xl text-center mt-5 mb-5 md:mt-8 md:mb-10">
    <slot />
</h2>
<style>
    h2 {
        scroll-margin-top: 100px;
    }
</style>