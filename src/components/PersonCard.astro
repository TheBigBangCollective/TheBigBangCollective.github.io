---
/**
 * One person on the About page: photo (or coloured initials), name and
 * affiliation. Used by the team sections and the collaborators map.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  name: string;
  affiliation?: string;
  link?: string;
  image?: ImageMetadata;
}

const { name, affiliation, link, image } = Astro.props;
const initials = name.split(/\s+/).map((part) => part[0]).slice(0, 2).join('');
---
<li class="person">
  {image
    ? <Image src={image} width={72} height={72} densities={[1, 2]} alt={`${name} headshot`} class="person-photo" />
    : <span class="person-initials" aria-hidden="true">{initials}</span>}
  <span class="person-name">{name}</span>
  {affiliation && (
    link
      ? <a href={link} class="person-affiliation">{affiliation}</a>
      : <span class="person-affiliation">{affiliation}</span>
  )}
</li>

<style>
  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    /* two per row on phones, 11rem cards elsewhere */
    width: min(11rem, calc(50% - 0.65rem));
    padding: 1.1rem 0.75rem 1rem;
    border-radius: 1rem;
    background: #fff;
    text-align: center;
    box-shadow: 0 6px 18px -10px rgba(0, 0, 0, 0.3);
  }
  .person :global(.person-photo),
  .person-initials {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 999px;
    object-fit: cover;
  }
  .person-initials {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: 1.3rem;
    color: #fff;
    /* takes the colour of the section it sits in */
    background: var(--accent, #374151);
  }
  .person-name {
    font-weight: 600;
    line-height: 1.3;
    color: #1f2937;
  }
  .person-affiliation {
    font-size: 0.8rem;
    color: #6b7280;
  }
  a.person-affiliation:hover { color: var(--accent, #374151); text-decoration: underline; }
</style>
