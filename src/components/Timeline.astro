---
/**
 * The festival line-up for a year: one card per festival on a vertical
 * "particle track", each with its logo, dates, text, video and a photo mosaic.
 * Photos and videos come from the year's markdown file (src/content/years).
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import { videoSlug, hlsUrl } from '../util/video.js';

interface Festival {
  name: string;
  start?: string;
  end?:   string;
  dates_note?: string;
  logo?:  string;
  images?: { src: string; title?: string; desc?: string }[];
  video?:  string;
  link?: { url: string; text: string };
  bg?:     string;
  text?:   string;
  description?: string;
  country:   string;
  sponsor?: string;
}

const { festivals }:{ festivals: Festival[] } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,svg}', { eager: true });
// Still frames for each video, named after the video file (see src/assets/posters)
const posters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/posters/*.jpg', { eager: true });
const posterFor = (url: string) => posters[`/src/assets/posters/${videoSlug(url)}.jpg`]?.default;

const slugify = (str: string) =>
  str.toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
const titleFromFilename = (path: string) =>
  (path.split('/').pop()?.split('.')[0] || '').replace(/_/g, ' ');

const dateRange = (f: Festival) => {
  if (!(f.start && f.end)) return f.dates_note || 'Dates to be confirmed';
  const start = new Date(f.start).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
  const end = new Date(f.end).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  return `${start} – ${end}`;
};

// Parts for the ticket-stub date: "MAR" / "17–20" / "2026"
const ticketFor = (f: Festival) => {
  if (!(f.start && f.end)) return undefined;
  const start = new Date(f.start), end = new Date(f.end);
  const month = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).slice(0, 3).toUpperCase();
  return {
    month: month(start) === month(end) ? month(start) : `${month(start)}–${month(end)}`,
    days: `${start.getUTCDate()}–${end.getUTCDate()}`,
    year: end.getUTCFullYear(),
  };
};

/* Sort chronologically; undated slots keep their authored order at the end */
const startValue = (f: Festival) => f.start ? new Date(f.start).valueOf() : Number.POSITIVE_INFINITY;
festivals.sort((a, b) => startValue(a) - startValue(b));

// Beside a film, photos sit in a 2x2 grid and the rest collapse into "+N".
// Without one, every photo shows in justified rows (see .justified below).
const SHOWN_WITH_VIDEO = 4;

const cards = await Promise.all(festivals.map(async (f) => {
  // An entry is a single image or a folder; folders contribute every image in them
  const photos: { src: ImageMetadata; full: string; title: string; ratio: number }[] = [];
  for (const entry of f.images ?? []) {
    const path = '/' + entry.src.replace(/^(\.\.\/)+/, '').replace(/^\//, '');
    const keys = Object.keys(allImages).filter((key) => key === path || key.startsWith(path + '/')).sort();
    for (const key of keys) {
      const src = allImages[key].default;
      const full = await getImage({ src, format: 'webp', width: 1600, quality: 80 });
      // EXIF orientations 5-8 are rotated a quarter turn, so width and height swap
      const turned = (src.orientation ?? 1) >= 5;
      const ratio = turned ? src.height / src.width : src.width / src.height;
      photos.push({ src, full: full.src, ratio, title: key === path && entry.title ? entry.title : titleFromFilename(key) });
    }
  }

  const poster = f.video ? posterFor(f.video) : undefined;
  const portrait = !!poster && poster.height > poster.width;
  const shown = f.video ? SHOWN_WITH_VIDEO : photos.length;

  return {
    ...f,
    id: slugify(f.name),
    dates: dateRange(f),
    ticket: ticketFor(f),
    accent: f.text || '#374151',
    band: f.bg || '#f3f4f6',
    logoImage: f.logo ? allImages[`/src/assets/${f.logo}`]?.default : undefined,
    sponsorImage: f.sponsor ? allImages[`/src/assets/${f.sponsor}`]?.default : undefined,
    year: f.start ? new Date(f.start).getFullYear() : '',
    photos,
    shown,
    poster,
    portrait,
  };
}));
---
<ol class="tl">
  {cards.map((c) => (
    <li id={c.id} class="tl-item" style={`--accent: ${c.accent}; --band: ${c.band}`}>
      <article class="tl-card">
        <span class="tl-dot" aria-hidden="true"></span>
        <header class="tl-head">
          {c.logoImage && (
            <Image src={c.logoImage} alt={`${c.name} logo`} width={64} densities={[1, 2]} class="tl-logo" />
          )}
          <div>
            <h3 class="tl-name">{c.name}</h3>
            <p class:list={['tl-dates', { 'sr-only': c.ticket }]}>{c.dates}</p>
          </div>
          {c.ticket && (
            <div class="tl-ticket tilt" aria-hidden="true">
              <div class="tl-ticket-body">
                <span class="tl-ticket-month">{c.ticket.month}</span>
                <span class="tl-ticket-days">{c.ticket.days}</span>
                <span class="tl-ticket-year">{c.ticket.year}</span>
              </div>
            </div>
          )}
        </header>

        {c.description && <p class="tl-text">{c.description}</p>}

        {(c.video || c.photos.length > 0) && (
          <div class:list={['tl-media', { 'has-video': c.video, 'has-photos': c.photos.length, portrait: c.portrait }]} data-lightbox-group>
            {c.video && (
              <div
                class="tl-video tilt"
                style={c.poster ? `aspect-ratio: ${c.poster.width} / ${c.poster.height}` : 'aspect-ratio: 16 / 9'}
              >
                {c.poster && (
                  <Image
                    src={c.poster}
                    alt={`${c.name} film`}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 768px) 55vw, 100vw"
                    class="tl-video-poster"
                    data-title={`${c.year} film`}
                    data-video={c.video}
                    data-hls={hlsUrl(c.video)}
                    data-portrait={c.portrait || undefined}
                  />
                )}
                <button type="button" class="tl-play" data-lightbox-open>
                  <span class="tl-play-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="w-7 h-7 fill-current ml-1"><path d="M8 5v14l11-7z" /></svg>
                  </span>
                  <span>Watch the {c.year} film</span>
                </button>
              </div>
            )}

            {c.photos.length > 0 && (
              <div
                class:list={['tl-photos', c.video ? `count-${Math.min(c.photos.length, c.shown)}` : 'justified']}
                style={c.video ? undefined : `--n: ${c.photos.length}; --sum: ${c.photos.reduce((t, p) => t + p.ratio, 0).toFixed(3)}`}
              >
                {c.photos.map((p, i) => (
                  <figure class:list={['tl-photo tilt', { 'tl-hidden': i >= c.shown }]} style={`--r: ${p.ratio.toFixed(3)}`}>
                    <Image
                      src={p.src}
                      alt={p.title}
                      widths={[320, 640]}
                      sizes={c.video ? "(min-width: 768px) 25vw, 50vw" : "(min-width: 768px) 400px, 60vw"}
                      data-title={p.title}
                      data-full-src={p.full}
                    />
                    {i === c.shown - 1 && c.photos.length > c.shown && (
                      <span class="tl-more" aria-hidden="true">+{c.photos.length - c.shown}</span>
                    )}
                  </figure>
                ))}
              </div>
            )}
          </div>
        )}

        {c.sponsorImage && (
          <div class="tl-sponsor">
            <Image src={c.sponsorImage} alt={`${c.name} sponsor logo`} width={150} class="object-contain" />
          </div>
        )}

        {c.link && (
          <a href={c.link.url} class="tl-link">
            {c.link.text} <span aria-hidden="true">↗</span>
          </a>
        )}
      </article>
    </li>
  ))}
</ol>

<Lightbox />


<style>
  /* full-width colour bands, softened with white so it doesn't read as a rainbow */
  .tl {
    position: relative;
  }
  .tl-item {
    position: relative;
    background: color-mix(in srgb, var(--band) 60%, white);
  }
  /* the content column; the line and dots live inside it so they stay
     beside the photos on wide screens */
  .tl-card {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem 3.5rem;
  }
  .tl-card::before {
    content: '';
    position: absolute;
    left: 1.45rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #9ca3af;
  }
  .tl-item:first-child .tl-card::before { top: 2.6rem; }
  .tl-item:last-child .tl-card::before { bottom: auto; height: 3rem; }
  .tl-dot {
    position: absolute;
    left: calc(1.45rem - 0.45rem);
    top: 2.6rem;
    z-index: 2;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--band) 60%, white);
    border: 2px solid var(--accent);
  }

  .tl-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .tl-head :global(.tl-logo) {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }
  .tl-name {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--accent);
  }
  /* ticket-stub dates: notched sides, a dashed perforation, slightly askew */
  .tl-ticket {
    --tilt: -4deg;
    margin-left: auto;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.18));
  }
  .tl-item:nth-child(even) .tl-ticket { --tilt: 3deg; }
  .tl-ticket-body {
    --notch: radial-gradient(circle at 0 50%, transparent 0.5rem, #000 0.53rem) left / 51% 100% no-repeat,
             radial-gradient(circle at 100% 50%, transparent 0.5rem, #000 0.53rem) right / 51% 100% no-repeat;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.55rem 1.4rem 0.5rem;
    white-space: nowrap;
    border-radius: 0.5rem;
    background: #fff;
    color: var(--accent);
    -webkit-mask: var(--notch);
    mask: var(--notch);
  }
  .tl-ticket-body::before {
    content: '';
    position: absolute;
    inset: 0.3rem 0.75rem;
    border: 1.5px dashed color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 0.3rem;
  }
  .tl-ticket-month {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
  }
  .tl-ticket-days {
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: 1.9rem;
    line-height: 1.05;
  }
  .tl-ticket-year {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
  }
  @media (max-width: 640px) {
    .tl-card { padding: 1.5rem 1rem 2rem 2.6rem; }
    .tl-card::before { left: 1.1rem; }
    .tl-dot { left: calc(1.1rem - 0.45rem); top: 2rem; }
    .tl-head { gap: 0.6rem; }
    .tl-head :global(.tl-logo) { width: 2.25rem; height: 2.25rem; }
    .tl-name { font-size: 1rem; }
    /* text stays inside the dashed line: padding is wider than its inset */
    .tl-ticket-body { padding: 0.4rem 0.95rem 0.35rem; }
    .tl-ticket-body::before { inset: 0.2rem 0.5rem; }
    .tl-ticket-month { font-size: 0.6rem; }
    .tl-ticket-days { font-size: 1rem; }
    .tl-ticket-year { display: none; }
    .tl-media { margin-top: 0.9rem; gap: 0.5rem; }
    .tl-photos { gap: 0.4rem; }
    .tl-photo, .tl-video { border-width: 3px; }
  }

  .tl-dates {
    display: inline-block;
    margin-top: 0.35rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.7);
  }

  .tl-text {
    margin-top: 1rem;
    max-width: 70ch;
    line-height: 1.7;
    white-space: pre-line;
    color: #374151;
  }

  /* ---------- media ---------- */
  .tl-media {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 768px) {
    .tl-media.has-video.has-photos { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: start; }
    .tl-media.has-video.has-photos.portrait { grid-template-columns: auto minmax(0, 1fr); }
  }

  .tl-video {
    position: relative;
    width: 100%;
    border-radius: 1rem;
    overflow: hidden;
    background: #111;
  }
  /* portrait films get a fixed width, so they sit beside the photos */
  .portrait .tl-video {
    width: min(100%, calc(min(70vh, 640px) * 9 / 16));
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .portrait.has-photos .tl-video { width: calc(min(70vh, 640px) * 9 / 16); }
  }
  .tl-video :global(.tl-video-poster) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tl-play {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    color: #fff;
    font-weight: 700;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.05) 60%);
  }
  .tl-play-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    border: 2px solid #fff;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.12);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .tl-video:hover .tl-play-icon,
  .tl-play:focus-visible .tl-play-icon {
    transform: scale(1.1);
    background: var(--accent);
  }

  /* photo mosaic */
  .tl-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .tl-photo {
    position: relative;
    margin: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: rgba(255, 255, 255, 0.5);
  }
  .tl-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }
  /* prints: white edge, a little shadow, each at its own slight angle */
  .tl-photo,
  .tl-video {
    border: 4px solid #fff;
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.35);
  }
  .tl-video { --tilt: -0.8deg; }
  .tl-photo:nth-child(odd) { --tilt: -1.4deg; }
  .tl-photo:nth-child(even) { --tilt: 1.2deg; }
  .tl-photo:nth-child(3n) { --tilt: 0.6deg; }
  .tl-photo:hover,
  .tl-video:hover { box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.45); z-index: 3; }
  .tl-hidden { display: none; }
  .tl-more {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.75rem;
    font-weight: 800;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  /* one photo fills the space; an odd count lets the first one lead */
  .count-1 { grid-template-columns: 1fr; }
  @media (min-width: 768px) {
    .tl-media.has-video:has(.count-1) { align-items: stretch; }
    .tl-media.has-video .count-1 .tl-photo { aspect-ratio: auto; height: 100%; }
  }
  .count-3 .tl-photo:first-child,
  .count-5 .tl-photo:first-child { grid-column: span 2; aspect-ratio: 16 / 9; }

  /* Photos-only cards: justified rows. Each photo keeps its own shape and
     grows in proportion to its width, so every row fills the card exactly
     with no cropping or holes, at any screen size. */
  .tl-photos.justified {
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* Row height that fits every photo on one line (--sum is the photos'
     combined width-to-height ratio); kept between 120 and 300px, so a
     narrow screen wraps onto more rows instead of shrinking to slivers. */
  .justified .tl-photo {
    --row: clamp(120px, (100cqw - (var(--n) - 1) * 0.75rem) / var(--sum), 300px);
  }
  @media (max-width: 640px) {
    .justified .tl-photo { --row: clamp(100px, (100cqw - (var(--n) - 1) * 0.4rem) / var(--sum), 300px); }
  }
  .justified .tl-photo {
    flex: var(--r) 1 calc(var(--r) * var(--row));
    aspect-ratio: var(--r);
  }
  /* lets a short last row stretch a little, but not into giant photos */
  .tl-photos.justified::after {
    content: '';
    flex: 1 1 0;
  }

  .tl-sponsor {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed rgba(0, 0, 0, 0.15);
    display: flex;
    justify-content: center;
  }
  .tl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.7);
    transition: background-color 0.2s ease;
  }
  .tl-link:hover { background: #fff; }
</style>
