---
/**
 * Front-page banner: a tilted, framed still from a video over a blurred copy
 * of the same still. A cut-out of the subject is layered over the frame so
 * their head breaks out above it; hovering straightens the frame.
 * The video (with sound) only loads when someone presses play, and plays in
 * the shared viewer (src/util/lightbox.js).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import { hlsUrl } from '../util/video.js';

interface Props {
  image: ImageMetadata;
  cutout: ImageMetadata;   // same frame as `image`, background removed
  alt: string;
  video: string;
  label: string;
  kicker?: string;
}

const { image, cutout, alt, video, label, kicker } = Astro.props;
const hls = hlsUrl(video);
---

<section class="bb-headline hero">
  <div class="hero-bg" aria-hidden="true">
    <Image src={image} alt="" width={24} quality={60} loading="eager" class="hero-backdrop" />
  </div>

  <div class="hero-inner">
    <span class="bb-title font-bold text-white drop-shadow-2xl">THE BIG BANG<br/>COLLECTIVE</span>

    <div class="hero-copy">
      {kicker && <p class="hero-kicker">{kicker}</p>}
    </div>

    <button type="button" class="hero-figure tilt" data-video={video} data-hls={hls} aria-label={`Play: ${label}`}>
      <span class="hero-frame" aria-hidden="true"></span>
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 600px, 92vw"
        loading="eager"
        fetchpriority="high"
        class="hero-still"
      />
      <Image
        src={cutout}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 600px, 92vw"
        loading="eager"
        class="hero-cutout"
      />
      <span class="hero-badge" aria-hidden="true">▶ Play</span>
    </button>
  </div>
</section>


<style>
  .hero {
    position: relative;
    color: #fff;
    background: #2a1a14;
    margin-bottom: 3.5rem;   /* room for the frame hanging over the edge */
  }
  /* blurred, darkened copy of the still fills the band */
  .hero :global(.hero-backdrop) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* a 24px-wide copy stretched to fill the band: blurry for free */
    transform: scale(1.1);
  }
  /* kept in its own box so the blur can't bleed past the band */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0) 60%),
      rgba(0, 0, 0, 0.45);
  }

  .hero {
    /* size of the big title, which is fixed-position so takes no space */
    --title-size: clamp(34px, 5.2vw, 84px);
  }
  .hero-inner {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    /* clear the title's two lines before anything else starts */
    padding: calc(2.5rem + var(--title-size) * 2.5 + 1.5rem) 1.5rem 0;
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 600px;
      min-height: min(70vh, 560px);
    }
  }

  /* the site title lines up with the content column while it's big */
  .hero :global(.bb-title:not(.bb-title-scrolled)) {
    left: 0;
    text-align: left;
    padding-left: max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem));
    font-size: var(--title-size);
  }

  .hero-copy {
    align-self: end;
    padding-bottom: 3.5rem;
  }
  @media (max-width: 1023px) {
    .hero-copy { padding-bottom: 0; }
  }
  /* phones: less empty space, smaller framed still */
  @media (max-width: 640px) {
    .hero { margin-bottom: 4.75rem; }
    .hero-inner {
      padding-top: calc(2.5rem + var(--title-size) * 3.1 + 0.25rem);
      gap: 0.75rem;
    }
    .hero-kicker { margin-bottom: 0; font-size: 0.9rem; }
    .hero-figure { width: 86%; margin: 0 auto -2.25rem; }
  }
  .hero-kicker {
    max-width: 28rem;
    margin-bottom: 1.5rem;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  /* ---------- framed still with the pop-out cut-out ---------- */
  .hero-figure {
    --cut: 24%;               /* how far down the frame's top edge sits */
    --tilt: 2deg;
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    aspect-ratio: 1730 / 984;
    margin-bottom: -3.5rem;   /* hang over the bottom of the band */
    cursor: pointer;
  }
  .hero-frame,
  .hero-figure :global(.hero-still),
  .hero-figure :global(.hero-cutout) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-frame {
    top: calc(var(--cut) - 8px);
    left: -8px; right: -8px; bottom: -8px;
    width: auto; height: auto;
    border-radius: 1.4rem;
    background: #fff;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }
  .hero-figure :global(.hero-still) {
    object-fit: cover;
    clip-path: inset(var(--cut) 0 0 0 round 1rem);
  }
  /* same frame with the background removed: inside the frame it matches the
     still exactly, above it only Willie shows */
  .hero-figure :global(.hero-cutout) {
    object-fit: cover;
    pointer-events: none;
  }

  .hero-badge {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
    background: #dc2626;
    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.5);
  }

</style>

<script>
  import { openGallery, preload } from '../util/lightbox.js';
  import { bestSource } from '../util/video.js';

  // The framed still opens the film in the shared viewer
  document.querySelectorAll<HTMLButtonElement>('.hero [data-video]').forEach((btn) => {
    btn.addEventListener('touchstart', preload, { passive: true });
    btn.addEventListener('pointerover', preload);
    btn.addEventListener('click', () => {
      const href = bestSource(btn.dataset.video!, btn.dataset.hls);
      openGallery([{ type: 'video', href, title: btn.getAttribute('aria-label') || '' }], 0, btn);
    });
  });
</script>
