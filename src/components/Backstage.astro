---
/**
 * Backstage Science: each film is a tilted, framed still with a cut-out of
 * the artist breaking out above the frame (like Willie on the front page).
 * Clicking opens the film in the shared viewer, where you can arrow through
 * every artist.
 *
 * To publish an unreleased film, flip its toggle below.
 */
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro:assets";
import Lightbox from "./Lightbox.astro";
import { hlsUrl } from "../util/video.js";

// --- VIDEO RELEASE TOGGLES ---
// Set a video to `true` to make it public.
// Or, set `releaseAll` to `true` to publish everything.
const releaseToggles = {
  releaseAll: false, // Master switch
  colinDave: true,   // Published
  jimDigby: true,    // Published
  jordanRudess: true,
  neilWestfall: true,
  micahNelson: true,
  qotsaPaleo: true,
};

// --- VIDEO DATA ---
// All video information is now in this single array.
const videos = [
  {
    id: "linkin-park-colin-dave",
    festival: "Hellfest",
    artist: "Colin & Dave",
    title: "Colin & Dave – Linkin Park (Hellfest 2025)",
    src: "https://thebigbangcollective.s3.eu-west-2.amazonaws.com/Linkin+Park+x+Hellfest+2025.mp4",
    description: "His first connection was with Colin and Dave from Linkin Park, how they see using A.I. in music and the creative process, take a look:",
    released: releaseToggles.releaseAll || releaseToggles.colinDave,
  },
  {
    id: "jim-digby",
    festival: "Hellfest",
    artist: "Jim Digby",
    title: "Jim Digby – Linkin Park Tour Director (Hellfest 2025)",
    src: "https://thebigbangcollective.s3.eu-west-2.amazonaws.com/Jim+Digby+x+Hellfest+2025.mp4",
    description: "Jim Digby, Linkin Park’s long time, highly respected Tour Director, made time for a chat with Eduardo too backstage, giving us some insights into how science has changed the way he carries out key tasks in the tour management process:",
    released: releaseToggles.releaseAll || releaseToggles.jimDigby,
  },
  {
    id: "jordan-rudess",
    festival: "Hellfest",
    artist: "Jordan Rudess",
    title: "Jordan Rudess – Dream Theater (Hellfest 2025)",
    src: "https://thebigbangcollective.s3.eu-west-2.amazonaws.com/Dream+Theater+-+Hellfest+2025.mp4",
    description: "Eduardo went on to have a great chat with Jordan Rudess from Dream Theater, who is already working on a project with a team at M.I.T. in Boston using A.I. Hear the full chat:",
    released: releaseToggles.releaseAll || releaseToggles.jordanRudess,
  },
  {
    id: "neil-westfall",
    festival: "Hellfest",
    artist: "Neil Westfall",
    title: "Neil Westfall – A Day To Remember (Hellfest 2025)",
    src: "https://thebigbangcollective.s3.eu-west-2.amazonaws.com/ADTR_HellFest+2025.mp4",
    description: "And the final dressing room that Eduardo invaded was that of the very cool Neil Westfall of ADTR. Big Bang Collective member Connie Potter welcomed him and the rest of the band for a CERN tour, and Neil shares his reaction to being at this unique, world famous science facility as well as what he thought of science at school:",
    released: releaseToggles.releaseAll || releaseToggles.neilWestfall,
  },
  {
    id: "micah-nelson",
    festival: "Montreux",
    artist: "Micah Nelson",
    title: "Micah Nelson – Particle Kid (Montreux Jazz 2025)",
    src: "https://thebigbangcollective.s3.eu-west-2.amazonaws.com/Micah+Nelson+x+Montreux+Jazz+Festival+2025.mp4",
    description: "At the Montreux Jazz Festival, Big Bang Collective member Connie Potter spent a few hours backstage at the Neil Young show, chatting with the team and specifically with Micah Nelson, guitarist with the Chrome Hearts. Neil also goes by the name Particle Kid and his fascination with science is clear to see. He even told us about a show he did a few years back incorporating an extraordinary natural process called cymatics. It blew our mind, and we have a feeling we’ll be hearing more from Micah in the future. Watch our chat with Micah Nelson here:",
    released: releaseToggles.releaseAll || releaseToggles.micahNelson,
  },
  {
    id: "qotsa-paleo",
    festival: "Paleo",
    artist: "Queens of the Stone Age",
    title: "Queens of the Stone Age (Paleo Festival 2025)",
    src: "https://thebigbangcollective.s3.eu-west-2.amazonaws.com/QOTSA_CERN.mp4",
    description: "Queens of the Stone Age visited CERN for a tour with Connie Potter. Take a look:",
    released: releaseToggles.releaseAll || releaseToggles.qotsaPaleo,
  },
];

const festivalLabels: Record<string, string> = {
  Hellfest: 'Hellfest',
  Montreux: "Montreux Jazz '25",
  Paleo: 'Paleo Festival',
};

// Each film's still and the same frame with the background removed
// (src/assets/backstage/<id>.jpg and <id>-cutout.png). `cut` is how far down
// the frame's top edge sits, so the artist's head breaks out above it.
const stills = import.meta.glob<{ default: ImageMetadata }>('/src/assets/backstage/*.jpg', { eager: true });
const cutouts = import.meta.glob<{ default: ImageMetadata }>('/src/assets/backstage/*-cutout.png', { eager: true });
const cuts: Record<string, number> = {
  'linkin-park-colin-dave': 43,
  'jim-digby': 21,
  'jordan-rudess': 31,
  'neil-westfall': 24,
  'micah-nelson': 30,
  'qotsa-paleo': 13,   // low enough to keep the half-hidden man's whole head in the frame
};
// Where someone's head was already cut off by the top of the original photo,
// only the part of the picture left of this % breaks out of the frame; they
// stay inside it, cropped by the white edge like a normal photo.
const breakOutUpTo: Record<string, number> = {
  'neil-westfall': 62,
};

const cases = await Promise.all(videos.map(async (video) => {
  const still = stills[`/src/assets/backstage/${video.id}.jpg`]?.default;
  return {
    ...video,
    still,
    stillFull: still ? (await getImage({ src: still, format: 'webp', width: 900, quality: 75 })).src : undefined,
    cutout: cutouts[`/src/assets/backstage/${video.id}-cutout.png`]?.default,
    cut: cuts[video.id] ?? 20,
    keep: breakOutUpTo[video.id] ?? 100,
    hls: hlsUrl(video.src),
  };
}));
---
<section class="backstage">
  <!-- the all-access pass, swinging on its lanyard -->
  <div class="pass" aria-hidden="true">
    <span class="pass-strap"></span>
    <div class="pass-card">
      <span class="pass-band">ALL ACCESS</span>
      <span class="pass-title">Backstage<br/>Science</span>
      <span class="pass-sub">The Big Bang Collective</span>
    </div>
  </div>

  <header class="bs-head">
    <h1 class="bs-title">Backstage Science</h1>
  </header>

  <div class="bs-paper">
    <p>
      The Big Bang Collective have been meeting up with members of some of the
      coolest bands around at festivals this summer, talking backstage with
      musicians about their interest in science and technology, where we are
      going with A.I. and all things creative and emotional. This coming
      together of the science and artistic worlds in an informal, relaxed
      setting shows how closely the two are intertwined, right down to the long,
      stressful, tiring process of producing an album or a science experiment.
      The similarities are rarely seen because they're often hidden from public
      view, but the creative and intellectual challenges are strikingly similar.
    </p>
    <p><strong>We are calling this Backstage Science.</strong></p>
  </div>

  <div class="bs-floor">
    <!-- cables snaking across the floor behind the films -->
    <svg class="bs-cables" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-20 140 C 220 60, 300 330, 520 250 S 860 120, 1020 300" />
      <path d="M-20 560 C 180 640, 360 420, 560 560 S 820 760, 1020 620" />
      <path d="M120 1020 C 160 820, 420 900, 470 760 S 700 640, 760 1020" />
    </svg>

    <ul class="bs-cases" data-lightbox-group>
      {cases.map((c) => (
        <li id={c.id} class:list={['bs-item', { locked: !c.released }]}>
          {c.released ? (
            <button
              type="button"
              class="film tilt"
              data-lightbox-open
              aria-label={`Watch: ${c.title}`}
              style={c.still ? `--cut: ${c.cut}%; --keep: ${c.keep}%; aspect-ratio: ${c.still.width} / ${c.still.height}` : undefined}
            >
              <span class="film-frame" aria-hidden="true"></span>
              {c.still && (
                <Image
                  src={c.still}
                  alt={c.title}
                  widths={[400, 800]}
                  sizes="(min-width: 768px) 30vw, 90vw"
                  class="film-still"
                  data-title={c.title}
                  data-full-src={c.stillFull}
                  data-video={c.src}
                  data-hls={c.hls}
                  data-portrait
                />
              )}
              {c.cutout && (
                <Image src={c.cutout} alt="" widths={[400, 800]} sizes="(min-width: 768px) 30vw, 90vw" class="film-cutout" data-lightbox-skip />
              )}
              <span class="film-play" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current ml-0.5"><path d="M8 5v14l11-7z" /></svg>
                Watch
              </span>
            </button>
          ) : (
            <div class="film-soon">🔒 Coming soon</div>
          )}
          <h2 class="bs-film-title">{c.title}</h2>
          <p class="bs-film-text">{c.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<Lightbox />

<style>
  .backstage {
    position: relative;
    overflow: hidden;
    color: #e7e5e4;
    /* black stage curtain folds across the top, dark floor below */
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 46px, rgba(0,0,0,0.35) 46px 60px) top / 100% 15rem no-repeat,
      linear-gradient(#0d0d10, #1b1a1f 15rem, #232127);
  }

  /* hazard tape along the top edge */
  .backstage::before {
    content: '';
    display: block;
    height: 14px;
    background: repeating-linear-gradient(-45deg, #facc15 0 18px, #111 18px 36px);
  }

  .bs-head {
    text-align: center;
    padding: 3rem 1rem 1rem;
  }
  .bs-title {
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: clamp(2.4rem, 7vw, 5rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #f5f5f4;
    /* stencil spray: soft edge glow */
    text-shadow: 0 0 1px rgba(255,255,255,0.4), 0 6px 24px rgba(0,0,0,0.6);
  }

  /* ---------- all-access pass ---------- */
  .pass {
    position: absolute;
    top: 0;
    right: 1.5rem;
    z-index: 3;
    transform-origin: top center;
    animation: swing 6s ease-in-out infinite;
  }
  .pass-strap {
    display: block;
    width: 18px;
    height: clamp(4rem, 12vw, 9rem);
    margin: 0 auto;
    background: repeating-linear-gradient(0deg, #dc2626 0 10px, #b91c1c 10px 20px);
  }
  .pass-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 9.5rem;
    padding: 0 0 0.9rem;
    border-radius: 0.6rem;
    overflow: hidden;
    color: #111;
    background: linear-gradient(160deg, #fff 60%, #e5e7eb);
    box-shadow: 0 14px 28px -10px rgba(0,0,0,0.7);
    text-align: center;
  }
  .pass-band {
    width: 100%;
    padding: 0.35rem 0;
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: #fff;
    background: #dc2626;
  }
  .pass-title {
    font-family: 'Arial Black', Arial, sans-serif;
    font-size: 1.05rem;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .pass-sub { font-size: 0.6rem; font-weight: 600; color: #6b7280; padding: 0 0.5rem; }
  @keyframes swing {
    0%, 100% { transform: rotate(4deg); }
    50% { transform: rotate(-3deg); }
  }
  .pass:hover { animation-duration: 1.2s; }
  @media (max-width: 1279px) {
    .pass { display: none; }
  }

  /* ---------- intro on a taped-up sheet ---------- */
  .bs-paper {
    position: relative;
    max-width: 44rem;
    margin: 1rem auto 1rem;
    padding: 1.75rem 2rem 1.5rem;
    color: #292524;
    background: #faf7f0;
    line-height: 1.7;
    transform: rotate(-0.8deg);
    box-shadow: 0 18px 30px -18px rgba(0,0,0,0.8);
  }
  .bs-paper p + p { margin-top: 0.9rem; }
  /* two strips of gaffer tape holding it up */
  .bs-paper::before,
  .bs-paper::after {
    content: '';
    position: absolute;
    top: -12px;
    width: 90px;
    height: 26px;
    background: rgba(161, 161, 170, 0.85);
  }
  .bs-paper::before { left: 1.5rem; transform: rotate(-6deg); }
  .bs-paper::after { right: 1.5rem; transform: rotate(5deg); }
  @media (max-width: 640px) {
    .bs-paper { margin: 1rem 1rem 0.5rem; padding: 1.5rem 1.25rem; }
  }

  /* ---------- the floor of cases ---------- */
  .bs-floor {
    position: relative;
    padding: 0 1rem 5rem;
  }
  .bs-cables {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .bs-cables { display: none; }   /* they'd run behind the text in one column */
  }
  .bs-cables path {
    fill: none;
    stroke: #050506;
    stroke-width: 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 2px 0 rgba(255,255,255,0.06));
  }

  .bs-cases {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 4.5rem 3rem;
    max-width: 72rem;
    margin: 0 auto;
    padding-top: 0.5rem;
  }
  .bs-item { scroll-margin-top: 8rem; }
  /* one column on phones: closer together, with a thin line between films */
  @media (max-width: 640px) {
    .bs-cases { gap: 0; padding-top: 0; }
    .bs-item { padding: 1.25rem 0 1.75rem; }
    .bs-item + .bs-item { border-top: 1px solid rgba(231, 229, 228, 0.18); }
  }

  /* ---------- tilted frame with the artist breaking out of the top ---------- */
  .film {
    --tilt: 2deg;
    position: relative;
    display: block;
    width: 100%;
    cursor: pointer;
  }
  .bs-item:nth-child(even) .film { --tilt: -2deg; }
  .film-frame,
  .film :global(.film-still),
  .film :global(.film-cutout) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .film-frame {
    top: calc(var(--cut) - 7px);
    left: -7px; right: -7px; bottom: -7px;
    width: auto; height: auto;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 24px 40px -18px #000;
  }
  .film :global(.film-still) {
    object-fit: cover;
    clip-path: inset(var(--cut) 0 0 0 round 0.7rem);
  }
  .film :global(.film-cutout) {
    object-fit: cover;
    pointer-events: none;
    /* below the frame edge the still shows the same thing, so the cut-out
       can be trimmed on the right without anyone noticing */
    -webkit-mask-image: linear-gradient(to right, #000 var(--keep), transparent var(--keep));
    mask-image: linear-gradient(to right, #000 var(--keep), transparent var(--keep));
  }
  .film-play {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 1rem 0.45rem 0.8rem;
    border-radius: 999px;
    font-weight: 700;
    color: #fff;
    background: #dc2626;
    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.6);
    transition: transform 0.25s ease;
  }
  .film:hover .film-play,
  .film:focus-visible .film-play { transform: scale(1.08); }

  .film-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    border: 2px dashed #57534e;
    border-radius: 1rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #facc15;
  }

  .bs-film-title {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #fafaf9;
  }
  .bs-film-text {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #a8a29e;
  }

  @media (prefers-reduced-motion: reduce) {
    .pass { animation: none; }
  }
</style>
