---
/**
 * Drop-in alternative to <BannerVideo> for the `banner` slot of FrontPage:
 * a pair of photos side by side, carrying the same site title overlay.
 *
 * Images are passed in so the component stays reusable year to year.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
---

<section class="bb-headline banner-images w-full shadow-lg">
  {images.map(({ src, alt }) => (
    <Image src={src} alt={alt} widths={[600, 1000, 1600]} class="banner-img" />
  ))}

  <span class="bb-title font-bold text-white drop-shadow-2xl">THE BIG BANG<br/>COLLECTIVE</span>
</section>

<style>
  .banner-images {
    display: flex;
    /* Matches the showreel's framing so the page below is unaffected. */
    aspect-ratio: 16 / 9;
    max-height: 600px;
    overflow: hidden;
    background-color: #474284;
  }

  .banner-images :global(.banner-img) {
    flex: 1 1 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Each half is narrow on phones, so let the banner grow taller
     rather than cropping the photos to slivers. */
  @media (max-width: 640px) {
    .banner-images {
      aspect-ratio: 3 / 2;
    }
  }
</style>
