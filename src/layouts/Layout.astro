---
import "../styles/global.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";

import BubbleChamber from '../components/BubbleChamber.astro';
import Head          from '../components/Head.astro';
import Header        from '../components/Header.astro';

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title}/>
  </head>

  <body>
    <!-- scroll-aware top bar -->
    <Header/>

    <BubbleChamber/>
    <slot/>

    <!-- credits, billed like a festival line-up -->
    <footer class="lineup">
      <span class="lineup-kicker">Website dev team</span>
      <span class="lineup-acts">
        <a href="https://orlandopb.com/" class="act tilt act-1">Orlando</a>
        <span class="star" aria-hidden="true">✦</span>
        <a href="https://github.com/greatestwx" class="act tilt act-2">Julian</a>
        <span class="star" aria-hidden="true">✦</span>
        <a href="https://www.k-si.com/" class="act tilt act-3">Kaj</a>
      </span>
      <span class="lineup-small">
        made with
        <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="love"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        and lots of physics
      </span>
    </footer>

    <style>
      .lineup {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 1.25rem;
        padding: 1.1rem 1rem;
        color: #9ca3af;
        background: #1f2937;
      }
      .lineup-kicker {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: uppercase;
      }
      .lineup-acts {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      /* every act billed the same size, each in its own festival colours */
      .act {
        --tilt: -3deg;
        display: inline-block;
        font-family: 'Arial Black', Arial, sans-serif;
        font-size: 1.15rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .act-1 { background-image: linear-gradient(90deg, #fbbf24, #f472b6); }
      .act-2 { --tilt: 2deg; background-image: linear-gradient(90deg, #34d399, #60a5fa); }
      .act-3 { --tilt: -2deg; background-image: linear-gradient(90deg, #a78bfa, #f472b6); }
      .star { color: #fbbf24; font-size: 0.8rem; }
      .lineup-small { font-size: 0.85rem; }

      .heart {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        vertical-align: -2px;
        fill: #ef4444;
        animation: heartbeat 1.2s ease-in-out infinite;
      }
      /* lub-dub */
      @keyframes heartbeat {
        0%, 40%, 100% { transform: scale(1); }
        10% { transform: scale(1.3); }
        20% { transform: scale(1.05); }
        30% { transform: scale(1.25); }
      }
      .lineup:hover .heart { animation-duration: 0.6s; }
      @media (prefers-reduced-motion: reduce) {
        .heart { animation: none; }
      }
    </style>
  </body>
</html>
