---
/**
 * Shared front-page shell.
 *
 * The banner defaults to the looping showreel. A page that wants something
 * else in that spot passes it in via the `banner` slot, e.g.
 *   <FrontPage>
 *     <BannerImages slot="banner" />
 *     …
 *   </FrontPage>
 * Any page that does not is left untouched.
 */
import Layout from "../layouts/Layout.astro";
import BannerVideo from "../components/BannerVideo.astro";
import backgroundImage from '../assets/womad-wop-banner-full.jpg';
---

<Layout>
    <slot name="banner">
        <BannerVideo src={backgroundImage} class="bb-headline bg-cover bg-center w-full h-full max-h-[600px] shadow-lg flex items-center justify-center text-center">
            <span class="bb-title font-bold text-white drop-shadow-2xl">THE BIG BANG<br/>COLLECTIVE</span>
        </BannerVideo>
    </slot>
    <slot />
</Layout>
<script>
	import {initScrollHeader} from '../util/scroll-header.js';
	initScrollHeader();
</script>
